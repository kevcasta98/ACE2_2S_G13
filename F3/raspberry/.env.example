# Copiar este archivo como .env y completar el token del bot de Telegram.
PORTUS_TELEGRAM_TOKEN=PEGAR_TOKEN_AQUI
# Obligatorio si hay 2 Arduinos por USB: usar ruta estable del Mega principal.
# Ver: ls -l /dev/serial/by-id/
# PORTUS_SERIAL_PORT=/dev/serial/by-id/USB_ID_DEL_MEGA_GARITA
PORTUS_MQTT_HOST=localhost
PORTUS_MQTT_PORT=1883
# Cámara conectada directamente a Raspberry Pi
PORTUS_CAMARA=0
# Zonas definidas como x,y,ancho,alto entre 0 y 1; calibrar con cámara real
PORTUS_ROI_PLACA=0.40,0.25,0.57,0.50
PORTUS_ROI_COLA=0.0,0.0,0.45,1.0
# Preentrenado COCO descargado previamente y disponible sin conexión
PORTUS_MODELO_CONTEO=/home/portus/portus/modelos/yolov8n.pt
# Modelo detector de PLACAS preentrenado opcional; caída -> ROI fija OCR.
# Debe ser detector de placas, no modelo COCO genérico.
# PORTUS_MODELO_PLACAS=/home/portus/portus/modelos/detector_placas.pt
